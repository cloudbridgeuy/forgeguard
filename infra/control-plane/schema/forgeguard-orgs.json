{
  "tableName": "forgeguard-{env}-orgs",
  "partitionKey": "PK",
  "sortKey": "SK",
  "itemTypes": {
    "org": {
      "pk": "ORG#{org_id}",
      "sk": "META",
      "attributes": {
        "name": { "type": "S", "required": true },
        "status": { "type": "S", "required": true },
        "created_at": { "type": "S", "required": true },
        "updated_at": { "type": "S", "required": true },
        "cognito_pool_id": { "type": "S", "required": false },
        "cognito_jwks_url": { "type": "S", "required": false },
        "policy_store_id": { "type": "S", "required": false },
        "config": { "type": "S", "required": true, "format": "json" },
        "etag": { "type": "S", "required": true },
        "signing_keys": { "type": "S", "required": false, "format": "json" }
      }
    },
    "membership": {
      "pk": "USER#{user_id}",
      "sk": "ORG#{org_id}",
      "attributes": {
        "user_id": { "type": "S", "required": true },
        "org_id": { "type": "S", "required": true },
        "groups": { "type": "L", "required": true },
        "joined_at": { "type": "S", "required": true },
        "email": { "type": "S", "required": true },
        "created_by": { "type": "S", "required": true },
        "GSI1PK": { "type": "S", "required": true, "value": "ORG#{org_id}" },
        "GSI1SK": { "type": "S", "required": true, "value": "USER#{user_id}" }
      }
    },
    "group": {
      "pk": "ORG#{org_id}",
      "sk": "GROUP#{name}",
      "attributes": {
        "config": { "type": "S", "required": true, "format": "json" },
        "etag": { "type": "S", "required": true }
      }
    },
    "user_schema": {
      "pk": "ORG#{org_id}",
      "sk": "USER_SCHEMA",
      "attributes": {
        "schema": { "type": "S", "required": true, "format": "json" },
        "etag": { "type": "S", "required": true }
      }
    },
    "seq_counter": {
      "pk": "ORG#{org_id}",
      "sk": "SEQ",
      "attributes": {
        "seq": { "type": "N", "required": true }
      }
    },
    "event": {
      "pk": "ORG#{org_id}",
      "sk": "EVT#{seq:020}",
      "attributes": {
        "event_id": { "type": "S", "required": true },
        "seq": { "type": "N", "required": true },
        "kind": { "type": "S", "required": true },
        "occurred_at": { "type": "S", "required": true },
        "actor": { "type": "S", "required": true },
        "narrowing": { "type": "S", "required": true },
        "schema_version": { "type": "N", "required": true },
        "payload": { "type": "S", "required": true, "format": "json" },
        "key_id": { "type": "S", "required": true },
        "signature": { "type": "S", "required": true }
      }
    },
    "principal": {
      "pk": "ORG#{org_id}",
      "sk": "PRINCIPAL#{native_id}",
      "attributes": {
        "payload": { "type": "S", "required": true, "format": "json" },
        "updated_at": { "type": "S", "required": true }
      }
    }
  }
}
